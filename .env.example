# Ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_API_KEY=ollama

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Candidate order, choose any one of the following three lines to set the priority of the models. The first model in the list will be used first, and if it fails, the next model will be used, and so on. 
#MODEL_PRIORITY=ollama,gemini,anthropic
#MODEL_PRIORITY=gemini,ollama,anthropic
MODEL_PRIORITY=anthropic,gemini,ollama