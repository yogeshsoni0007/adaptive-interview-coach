# Ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_API_KEY=ollama

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Candidate order, choose any one of the following three lines to set the priority of the models. The first model in the list will be used first, and if it fails, the next model will be used, and so on. 
#MODEL_PRIORITY=ollama,gemini,anthropic
#MODEL_PRIORITY=gemini,ollama,anthropic
MODEL_PRIORITY=anthropic,gemini,ollama

# Interview question TTS. Browser is always appended as the final fallback.
# Reorder here, or remove this override and edit tts/config.py. Restart after edits.
TTS_PRIORITY=elevenlabs,google,azure,local,browser
TTS_LANGUAGE=en-US
TTS_SPEED=0.92
TTS_TIMEOUT_SECONDS=4
TTS_FALLBACK_BUDGET_SECONDS=8
TTS_COOLDOWN_SECONDS=60

TTS_ELEVENLABS_API_KEY=
TTS_ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
TTS_ELEVENLABS_MODEL=eleven_flash_v2_5

# Cloud Text-to-Speech credentials, separate from the question-generation Gemini key.
TTS_GOOGLE_API_KEY=
# Alternatively supply a short-lived OAuth access token and quota project.
TTS_GOOGLE_ACCESS_TOKEN=
TTS_GOOGLE_PROJECT=
TTS_GOOGLE_VOICE=en-US-Neural2-F

TTS_AZURE_API_KEY=
TTS_AZURE_REGION=
TTS_AZURE_VOICE=en-US-JennyNeural

# Optional separately installed Kokoro-FastAPI server: http://127.0.0.1:8880/v1
TTS_LOCAL_BASE_URL=
TTS_LOCAL_MODEL=kokoro
TTS_LOCAL_VOICE=af_bella
